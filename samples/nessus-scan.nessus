<?xml version="1.0" ?>
<!-- Synthetic Nessus export for demonstration. Addresses are RFC 5737
     documentation ranges and no real host was scanned. -->
<NessusClientData_v2>
  <Report name="vulnerable-demo external" xmlns:cm="http://www.nessus.org/cm">
    <ReportHost name="203.0.113.10">
      <HostProperties>
        <tag name="host-ip">203.0.113.10</tag>
        <tag name="operating-system">Linux Kernel 5.15 on Ubuntu 22.04</tag>
        <tag name="host-fqdn">vulnerable-demo.test</tag>
      </HostProperties>

      <ReportItem port="443" svc_name="www" protocol="tcp" severity="4" pluginID="157288"
                  pluginName="OpenSSL 3.0.x &lt; 3.0.7 Multiple Vulnerabilities" pluginFamily="Web Servers">
        <description>The remote host uses a version of OpenSSL prior to 3.0.7 and is affected by a buffer overflow in punycode decoding during certificate verification.</description>
        <solution>Upgrade OpenSSL to version 3.0.7 or later.</solution>
        <risk_factor>Critical</risk_factor>
        <cvss3_base_score>9.8</cvss3_base_score>
        <cvss3_vector>CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H</cvss3_vector>
        <cve>CVE-2022-3602</cve>
        <cwe>787</cwe>
        <plugin_output>Installed version : 3.0.2
Fixed version : 3.0.7</plugin_output>
      </ReportItem>

      <ReportItem port="443" svc_name="www" protocol="tcp" severity="2" pluginID="104743"
                  pluginName="TLS Version 1.0 Protocol Detection" pluginFamily="Service detection">
        <description>The remote service accepts connections encrypted using TLS 1.0, which has known design weaknesses and is deprecated.</description>
        <solution>Enable support for TLS 1.2 or 1.3 and disable TLS 1.0.</solution>
        <risk_factor>Medium</risk_factor>
        <cvss3_base_score>6.5</cvss3_base_score>
        <cwe>327</cwe>
        <plugin_output>TLSv1 is enabled and the server supports at least one cipher.</plugin_output>
      </ReportItem>

      <ReportItem port="22" svc_name="ssh" protocol="tcp" severity="1" pluginID="153953"
                  pluginName="SSH Weak Key Exchange Algorithms Enabled" pluginFamily="Misc.">
        <description>The remote SSH server is configured to allow key exchange algorithms considered weak.</description>
        <solution>Disable the affected algorithms in sshd_config.</solution>
        <risk_factor>Low</risk_factor>
        <cwe>326</cwe>
      </ReportItem>

      <ReportItem port="0" svc_name="general" protocol="tcp" severity="0" pluginID="19506"
                  pluginName="Nessus Scan Information" pluginFamily="Settings">
        <description>This plugin displays information about the Nessus scan itself.</description>
        <solution>n/a</solution>
        <risk_factor>None</risk_factor>
        <plugin_output>Scanner edition used : Nessus
Scan policy used : Basic Network Scan
Scan duration : 412 sec</plugin_output>
      </ReportItem>

      <ReportItem port="443" svc_name="www" protocol="tcp" severity="0" pluginID="10107"
                  pluginName="HTTP Server Type and Version" pluginFamily="Web Servers">
        <description>This plugin attempts to determine the type and version of the remote web server.</description>
        <solution>n/a</solution>
        <risk_factor>None</risk_factor>
        <plugin_output>The remote web server type is : nginx/1.24.0</plugin_output>
      </ReportItem>
    </ReportHost>
  </Report>
</NessusClientData_v2>
